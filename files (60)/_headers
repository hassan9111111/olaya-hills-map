# Cloudflare Pages reads this file automatically on deploy.
#
# The page itself and all data/logic files must always be revalidated with
# the server on every visit, so any update (new sale status, new plot data,
# a bug fix...) reaches every visitor on the SAME link immediately — no one
# needs a "new" link, and no one needs to hard-refresh manually.
#
# "no-cache" here does NOT mean "never cache" — it means the browser must
# ask the server "is my cached copy still the latest?" before using it.
# Since Cloudflare's edge always has the latest deployed version, this check
# is instant and the visitor always gets current content.

/index.html
  Cache-Control: no-cache

/app.js
  Cache-Control: no-cache

/styles.css
  Cache-Control: no-cache

/blocks-data.json
  Cache-Control: no-cache

/plots-data.json
  Cache-Control: no-cache

/real-badge-circles.json
  Cache-Control: no-cache

# The background image rarely changes and is large, so it's fine to let
# browsers cache it more aggressively for speed. If it's ever replaced,
# renaming the file (as done before) still guarantees an instant update.
/map-background-optimized.jpg
  Cache-Control: public, max-age=86400

/map-background-optimized.webp
  Cache-Control: public, max-age=86400
